[Unit]
Description=OSRI File Sync Daemon
After=network.target

[Service]
Type=simple
User=your_username
WorkingDirectory=/path/to/pdq/system
ExecStart=/usr/bin/python3 /path/to/pdq/system/file_sync_daemon.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

